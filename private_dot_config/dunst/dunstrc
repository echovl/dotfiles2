[global]
font = JetBrainsMono Nerd Font 10
browser = /usr/bin/xdg-open
show_indicators = yes
frame_width = 2
corner_radius = 2
# Apps mostly send icon names; Adwaita only has symbolic versions of most.
# icon_theme is ignored unless recursive lookup is on (built-in default: off).
icon_theme = "Papirus-Dark"
enable_recursive_icon_lookup = true
# Picks between a notification's actions (middle click); dmenu isn't installed.
dmenu = /usr/bin/rofi -dmenu -p dunst

# Colors come from tinty: dunstrc.d/90-tinty.conf
